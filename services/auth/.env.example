SERVICE_NAME=auth
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://auth:auth@localhost:5432/auth
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=taraborrelli.events
EVENTS_ENABLED=true
EVENTS_QUEUE=auth.consents
# PEM private key that signs access tokens (generate with infra/scripts/generate-jwt-keys.sh).
JWT_PRIVATE_KEY=
JWT_ALGORITHM=RS256
JWT_AUDIENCE=taraborrelli
JWT_ISSUER=taraborrelli-auth
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
