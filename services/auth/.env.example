SERVICE_NAME=auth
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://auth:auth@localhost:5432/auth
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=taraborrelli.events
EVENTS_ENABLED=true
EVENTS_QUEUE=auth.consents
# PEM private key that signs access tokens (generate with infra/scripts/generate-jwt-keys.sh).
JWT_PRIVATE_KEY=
JWT_ALGORITHM=RS256
JWT_AUDIENCE=taraborrelli
JWT_ISSUER=taraborrelli-auth
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Transactional email ("password dimenticata"): "outbox" saves emails as files, "smtp" sends
# through an SMTP server, "brevo" through Brevo's HTTPS API (BREVO_API_KEY).
EMAIL_BACKEND=outbox
EMAIL_OUTBOX_DIR=outbox
EMAIL_FROM=Immobiliare Taraborrelli <noreply@immobiliaretaraborrelli.it>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
BREVO_API_KEY=
PASSWORD_RESET_MINUTES=15

# Rate limiting inside the service, for hosts without the gateway (Render). With docker
# compose the gateway already limits the requests.
RATE_LIMIT_ENABLED=false

# First administrator, created at startup if none exists (hosts without a terminal, such as
# Render's free plan). Remove the password once logged in.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Amministratore
