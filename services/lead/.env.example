SERVICE_NAME=lead
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://lead:lead@localhost:5432/lead
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=taraborrelli.events
EVENTS_ENABLED=true
# PEM public key of the auth service (newlines as \n). Required for staff endpoints.
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_AUDIENCE=taraborrelli
JWT_ISSUER=taraborrelli-auth
VALUATION_COMPLETION_WINDOW_DAYS=7

# Notice to the agency for every new request (comma-separated; empty: no email is sent).
STAFF_NOTIFICATION_EMAILS=
# Admin panel address, for the link in the email.
ADMIN_PANEL_URL=http://localhost:5173
# "outbox" saves emails as files, "smtp" sends through an SMTP server, "brevo" through Brevo's
# HTTPS API (BREVO_API_KEY).
EMAIL_BACKEND=outbox
EMAIL_OUTBOX_DIR=outbox
EMAIL_FROM=Immobiliare Taraborrelli <noreply@immobiliaretaraborrelli.it>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
BREVO_API_KEY=
# "gmail_script": web app address and TOKEN of infra/email/gmail-sender.gs
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_TOKEN=

# Rate limiting inside the service, for hosts without the gateway (Render). With docker
# compose the gateway already limits the requests.
RATE_LIMIT_ENABLED=false
