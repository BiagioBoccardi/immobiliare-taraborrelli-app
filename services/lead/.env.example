SERVICE_NAME=lead
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://lead:lead@localhost:5432/lead
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=taraborrelli.events
EVENTS_ENABLED=true
# PEM public key of the auth service (newlines as \n). Required for staff endpoints.
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_AUDIENCE=taraborrelli
JWT_ISSUER=taraborrelli-auth
VALUATION_COMPLETION_WINDOW_DAYS=7
# Address search for the online estimate (OpenStreetMap Nominatim). Email: contact for
# Nominatim's usage policy; the agency's address is fine.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=ImmobiliareTaraborrelliApp/0.1 (valutazione immobili)
GEOCODER_EMAIL=
GEOCODER_VIEWBOX=13.85,42.55,14.80,41.65
