SERVICE_NAME=property
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://property:property@localhost:5432/property
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=taraborrelli.events
EVENTS_ENABLED=true
# PEM public key of the auth service (newlines as \n). Required for admin endpoints.
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_AUDIENCE=taraborrelli
JWT_ISSUER=taraborrelli-auth
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=property-media
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/property-media
# Cloudinary instead of S3 (free hosting): cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Local development only: create the bucket and make listing photos readable at startup.
S3_CREATE_BUCKET=false
MAX_PHOTO_BYTES=10485760
MAX_PHOTOS_PER_PROPERTY=40

# Excel import of listings from the management software
MAX_IMPORT_BYTES=5242880
MAX_IMPORT_ROWS=2000

# Rate limiting inside the service, for hosts without the gateway (Render). With docker
# compose the gateway already limits the requests.
RATE_LIMIT_ENABLED=false
