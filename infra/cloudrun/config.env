# Settings of the production deploy on Google Cloud Run, read by .github/workflows/deploy.yml.
# Nothing secret goes here: passwords and database addresses are in Google Secret Manager
# (created by infra/cloudrun/setup-gcp.sh). One KEY=value per line, no quotes.

# Printed at the end of infra/cloudrun/setup-gcp.sh.
GCP_PROJECT_ID=
GCP_REGION=europe-west1
GCP_WIF_PROVIDER=
GCP_DEPLOY_SA=
GCP_RUN_SA=

# Sites allowed to call the API from a browser (comma-separated): the agency's website and
# the admin panel on Netlify.
ALLOWED_ORIGINS=https://immobiliare-taraborrelli.netlify.app,https://www.immobiliaretaraborrelli.it
# Address of the admin panel on Netlify, for the link in the agency's email.
ADMIN_PANEL_URL=

# Listing photos on Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com, the bucket
# and its public address (Settings -> Public access -> r2.dev URL, or a custom domain).
S3_ENDPOINT_URL=
S3_BUCKET=property-media
MEDIA_PUBLIC_BASE_URL=

# Email: notices to the agency for every new request and "password dimenticata" codes.
# With Gmail: smtp.gmail.com, port 587, the Gmail address as user and sender, and an app
# password (stored as the smtp-password secret).
STAFF_NOTIFICATION_EMAILS=immobiliaretaraborrelli@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=immobiliaretaraborrelli@gmail.com
EMAIL_FROM=Immobiliare Taraborrelli <immobiliaretaraborrelli@gmail.com>
