{
  "name": "taraborrelli",
  "private": true,
  "workspaces": [
    "apps/admin",
    "apps/mobile",
    "packages/api-client",
    "packages/theme"
  ],
  "scripts": {
    "generate:api": "npm run generate --workspace @taraborrelli/api-client",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/jest": "30.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "three": "0.183.2",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "type": "module",
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
