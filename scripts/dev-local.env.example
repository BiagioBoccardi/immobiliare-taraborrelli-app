# Local settings for scripts/dev-local.sh. Copy this file to .dev-local.env (in the
# repository root, never committed) to really send emails during the local trial.
#
# Use a mailbox that offers SMTP. The sender (EMAIL_FROM) must be that same address.
#
# Gmail: create an "app password" (Google account > Security > 2-Step Verification >
# App passwords) and use it as SMTP_PASSWORD.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SSL=false
# Yahoo: create an "app password" (Account security > Generate app password).
#   SMTP_HOST=smtp.mail.yahoo.com  SMTP_PORT=465  SMTP_SSL=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USERNAME=indirizzo@gmail.com
SMTP_PASSWORD=password-per-app
EMAIL_FROM=Immobiliare Taraborrelli <indirizzo@gmail.com>
