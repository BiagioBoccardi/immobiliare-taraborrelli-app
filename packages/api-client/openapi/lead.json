  "paths": {
    "/api/v1/lead/leads": {
      "get": {
        "operationId": "list_leads_api_v1_lead_leads_get",
        "parameters": [
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/LeadKind"
                },
                {
                  "type": "null"
                }
              ],
