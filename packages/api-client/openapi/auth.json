          "granted": {
            "title": "Granted",
            "type": "boolean"
          },
          "policy_version": {
            "title": "Policy Version",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/ConsentPurpose"
          },
          "recorded_at": {
            "format": "date-time",
