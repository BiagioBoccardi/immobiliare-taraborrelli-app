            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/ConsentSource"
          }
        },
        "required": [
          "purpose",
          "granted",
          "policy_version",
          "source",
          "recorded_at"
        ],
        "title": "ConsentRecordOut",
        "type": "object"
      },
      "ConsentSource": {
        "enum": [
          "app",
          "web",
          "lead_form"
        ],
        "title": "ConsentSource",
        "type": "string"
      },
      "ConsentStatus": {
        "properties": {
          "granted": {
            "title": "Granted",
            "type": "boolean"
          },
          "policy_version": {
            "title": "Policy Version",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/ConsentPurpose"
          },
          "recorded_at": {
            "format": "date-time",
            "title": "Recorded At",
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "granted",
          "policy_version",
          "recorded_at"
