        "properties": {
          "marketing_accepted": {
            "default": false,
            "title": "Marketing Accepted",
            "type": "boolean"
          },
          "privacy_accepted": {
            "const": true,
            "title": "Privacy Accepted",
            "type": "boolean"
          },
          "privacy_policy_version": {
            "maxLength": 20,
            "minLength": 1,
            "title": "Privacy Policy Version",
            "type": "string"
          }
        },
        "required": [
          "privacy_accepted",
          "privacy_policy_version"
